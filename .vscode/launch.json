{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug CppEnv",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/CppEnv/out/main",
            "preLaunchTask": "g++ build CppEnv",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/CppEnv",
            "environment": [
                {
                    "name": "DEBUGINFOD_URLS",
                    "value": ""
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "miDebuggerArgs": "-q -iex \"set debuginfod enabled off\" -iex \"set stop-on-solib-events 0\"",
            "setupCommands": [
                {
                    "description": "Disable GDB debuginfod downloads",
                    "text": "set debuginfod enabled off",
                    "ignoreFailures": true
                },
                {
                    "description": "Do not stop on shared library events",
                    "text": "set stop-on-solib-events 0",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
