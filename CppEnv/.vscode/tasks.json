{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "g++ build",
            "command": "bash",
            "args": [
                "-lc",
                "mkdir -p \"${workspaceFolder}/out\" && g++ -g \"${workspaceFolder}/src/main.cpp\" -o \"${workspaceFolder}/out/main\" -I\"${workspaceFolder}/src\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "编译 src/main.cpp 到 out/main"
        },
        {
            "type": "shell",
            "label": "run in Terminal",
            "dependsOn": "g++ build",
            "command": "bash",
            "args": [
                "-lc",
                "\"${workspaceFolder}/out/main\""
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": false
            },
            "detail": "在 VS Code Terminal 中运行 out/main"
        }
    ]
}
